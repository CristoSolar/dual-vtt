{
  "name": "@daggerheart/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include 'src/**' --exclude '**/node_modules/**' src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@daggerheart/protocol": "workspace:*",
    "@daggerheart/rules": "workspace:*",
    "@daggerheart/srd-data": "workspace:*",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@daggerheart/character": "workspace:*"
  }
}
